# Operating system noise
.DS_Store
Thumbs.db

# Python caches, test output, and local virtual environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
env/
venv/
.venv/

# Environment files and local secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
red_teaming/.env
red_teaming/.env.*
!red_teaming/.env.example

# Node/frontend dependencies and generated build artifacts
frontend/node_modules/
frontend/build/
frontend/coverage/
frontend/.pnp
frontend/.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend runtime state and generated logs
backend/app/runtime/
backend/app/guardrails/log/
*.log

# Red-teaming run outputs and exported reports
red_teaming/data/runs/*.json
red_teaming/data/reports/*.json
red_teaming/data/reports/*.pdf
red_teaming/data/reports/backups/
red_teaming/data/logs/
red_teaming/data/analysis/*
!red_teaming/data/runs/.gitkeep
!red_teaming/data/reports/.gitkeep
!red_teaming/data/reports/rt-20260618-180138-af1204a6-final-results.json
!red_teaming/data/reports/rt-20260618-180138-af1204a6-final-results.pdf
!red_teaming/data/analysis/rt-20260618-180138-af1204a6/
!red_teaming/data/analysis/rt-20260618-180138-af1204a6/**

# Large local classifier assets. Keep the folder placeholder tracked.
services/subjectivity_classifier/model/*
!services/subjectivity_classifier/model/.gitkeep

# Keep the generated baseline profile data tracked for shared reproducibility.
!backend/app/data/persona_profiles.json
!backend/app/data/biographies.json
!backend/app/data/stylometric_profiles.json
