{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare Full Project",
      "type": "shell",
      "command": "bash scripts/prepare_project.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "project"
      }
    },
    {
      "label": "Start Full Project",
      "type": "shell",
      "command": "./start.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^(.*)$",
              "message": 1
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "== Safeguarding Synthetic Agency ==",
            "endsPattern": "\\[start\\] The local application is ready to open at http://127\\.0\\.0\\.1:"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "project"
      }
    }
  ]
}
