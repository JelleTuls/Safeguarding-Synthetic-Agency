{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup Project Dependencies",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Create Python Env",
        "Install Python Dependencies",
        "Install Frontend Dependencies"
      ],
      "problemMatcher": []
    },
    {
      "label": "Create Python Env",
      "type": "shell",
      "command": "test -d ${workspaceFolder}/env || python3 -m venv ${workspaceFolder}/env",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "setup"
      }
    },
    {
      "label": "Install Python Dependencies",
      "type": "shell",
      "command": "${workspaceFolder}/env/bin/python -m pip install -r backend/requirements.txt -r red_teaming/requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "setup"
      }
    },
    {
      "label": "Install Frontend Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "setup"
      }
    },
    {
      "label": "Start Full Project",
      "type": "shell",
      "command": "./start.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^(.*)$",
              "message": 1
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "== Safeguarding Synthetic Agency ==",
            "endsPattern": "Open the app at http://127.0.0.1:3000"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "servers"
      }
    },
    {
      "label": "Start Frontend + Backend",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "Stop Dev Environment",
        "Start Full Project",
        "Open Frontend"
      ],
      "problemMatcher": []
    },
    {
      "label": "Stop Dev Ports",
      "type": "shell",
      "command": "for port in 3000 8000 8010; do pids=$(lsof -ti tcp:$port 2>/dev/null); if [ -n \"$pids\" ]; then kill $pids 2>/dev/null || true; echo \"Stopped processes on port $port\"; fi; done; true",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "servers"
      }
    },
    {
      "label": "Stop Subjectivity Classifier",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "servers"
      }
    },
    {
      "label": "Stop Dev Environment",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Stop Dev Ports",
        "Stop Subjectivity Classifier"
      ],
      "problemMatcher": []
    },
    {
      "label": "Open Frontend",
      "type": "shell",
      "command": "for i in {1..45}; do nc -z 127.0.0.1 3000 && break; sleep 1; done; open http://localhost:3000",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "group": "servers"
      }
    }
  ]
}
