# Copy this file to backend/.env and fill only the provider block you want to use.
# Safe local defaults are already filled in. Do not commit backend/.env.
#
# Provider selection:
# - Keep "auto" for normal use.
# - The backend tries complete provider blocks in this order:
#   1. Generic OpenAI-compatible LLM_* block.
#   2. Azure OpenAI block.
#   3. OpenAI block.
#   4. Groq block.
LLM_PROVIDER=auto

# Generic OpenAI-compatible endpoint.
# Fill LLM_API_KEY and LLM_BASE_URL when using an institutional gateway,
# LM Studio, Ollama OpenAI-compatible server, or another /chat/completions API.
# Change LLM_MODEL only when your provider uses a different model/deployment name.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=

# Groq-compatible OpenAI API.
# For the quickest demo, fill only GROQ_API_KEY and leave the defaults below.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI API.
# Fill only OPENAI_API_KEY unless you want a different model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI-compatible API.
# Fill all three values. AZURE_OPENAI_MODEL is usually your Azure deployment name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_BASE_URL=

# Optional red-team evaluator preference.
# Leave auto to use the same provider order as the backend chat/generation flow.
RED_TEAM_GRADER_PROVIDER=auto

# Local service URLs.
# start.sh uses these defaults; change them only if you change the ports.
FRONTEND_URL=http://127.0.0.1:3000
RED_TEAM_SERVICE_URL=http://127.0.0.1:8010
SUBJECTIVITY_CLASSIFIER_URL=http://127.0.0.1:8001

# Local profile/cache behavior.
# Keep these false for normal reviewer/supervisor demos because cached profiles
# are already included in backend/app/data/.
SSA_ALLOW_BACKGROUND_PROFILE_GENERATION=false
SSA_GENERATE_MISSING_STYLOMETRY=false

# Active chat request locks automatically expire after this many seconds.
SSA_ACTIVE_REQUEST_TTL_SECONDS=240

# Local stdout log level. DEBUG gives the fullest narrative trace for thesis
# demos and diagnostics; lower this to INFO if the terminal becomes too noisy.
SSA_LOG_LEVEL=DEBUG

ENV=development
