# Choose one provider. Groq is the default fallback provider in backend/app/config.py.
LLM_PROVIDER=groq

# Groq-compatible OpenAI API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI-compatible API
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_BASE_URL=

# Optional. start.sh sets this automatically when Docker Compose starts the sidecar.
# If Docker is unavailable, Layer 08 uses the deterministic fallback scorer.
SUBJECTIVITY_CLASSIFIER_URL=http://127.0.0.1:8001
