# Provider selection.
# Use "auto" for dynamic routing:
# 1. LLM_API_KEY + LLM_MODEL + LLM_BASE_URL when all three are present.
# 2. Azure/OpenAI named provider when fully configured.
# 3. Groq only when one or two Groq keys are present.
LLM_PROVIDER=auto

# Easiest primary option: any OpenAI-compatible endpoint.
# This can be OpenAI, Groq, LM Studio, Ollama OpenAI-compatible server,
# Azure-compatible gateways, or another provider exposing /chat/completions.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional named provider configuration. Use these only if preferred.
#
# Groq-compatible OpenAI API
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI-compatible API
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_BASE_URL=

# Optional. start.sh sets this automatically when Docker Compose starts the sidecar.
# If Docker is unavailable, Layer 08 uses the deterministic fallback scorer.
SUBJECTIVITY_CLASSIFIER_URL=http://127.0.0.1:8001

ENV=development
